
# Rename to .env and fill values in production
PORT=3000
SECRET=change_this_secret

# Nodemailer (SMTP) example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="Psykeros <no-reply@psykeros.example>"

# Google OAuth2 (for Calendar integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://your-domain.com/google-oauth2callback
GOOGLE_REFRESH_TOKEN= (optional: store refresh token)

# Twilio (optional, for US phone)
TWILIO_ACCOUNT_SID=AC685cdd9044d48a71935e541b57cda9f6
TWILIO_AUTH_TOKEN=db627b718d1d852767d79b6f99f42098
TWILIO_PHONE_NUMBER=+15642262522

# Admin user for portal (example)
ADMIN_EMAIL=admin@psykeros.example
ADMIN_PASS=change_this_password
